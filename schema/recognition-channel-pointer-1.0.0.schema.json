{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rxscan.ca/publication/recognition-channel-pointer-1.0.0.schema.json",
  "additionalProperties": false,
  "properties": {
    "approvalId": { "type": "string", "minLength": 1 },
    "approvalPath": { "$ref": "#/$defs/relativePath" },
    "channel": { "const": "recognition-stable" },
    "collisionCount": { "type": "integer", "minimum": 0 },
    "consumptionAuthorized": { "const": true },
    "generatedAt": { "type": "string", "format": "date-time" },
    "generation": { "type": "integer", "minimum": 1 },
    "identityCount": { "type": "integer", "minimum": 0 },
    "manifestPath": { "$ref": "#/$defs/relativePath" },
    "manifestSha256": { "$ref": "#/$defs/sha256" },
    "metadataPath": { "$ref": "#/$defs/relativePath" },
    "previousReleaseId": { "type": ["string", "null"] },
    "profilePath": { "$ref": "#/$defs/relativePath" },
    "profileSha256": { "$ref": "#/$defs/sha256" },
    "promotedAt": { "type": "string", "format": "date-time" },
    "releaseId": { "type": "string", "pattern": "^recognition-common-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
    "releasePath": { "$ref": "#/$defs/relativePath" },
    "rollback": {
      "additionalProperties": false,
      "properties": {
        "fromReleaseId": { "type": ["string", "null"] },
        "isRollback": { "type": "boolean" },
        "reason": { "type": ["string", "null"] }
      },
      "required": ["fromReleaseId", "isRollback", "reason"],
      "type": "object"
    },
    "schemaVersion": { "const": "1.0.0" },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "stableMetadataSha256": { "$ref": "#/$defs/sha256" },
    "status": { "const": "stable" },
    "termCount": { "type": "integer", "minimum": 0 }
  },
  "required": [
    "schemaVersion",
    "channel",
    "releaseId",
    "releasePath",
    "metadataPath",
    "manifestPath",
    "profilePath",
    "approvalPath",
    "sourceCommit",
    "manifestSha256",
    "profileSha256",
    "stableMetadataSha256",
    "generatedAt",
    "promotedAt",
    "identityCount",
    "termCount",
    "collisionCount",
    "status",
    "consumptionAuthorized",
    "approvalId",
    "generation",
    "previousReleaseId",
    "rollback"
  ],
  "type": "object",
  "$defs": {
    "relativePath": {
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9@._/-]+$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  }
}
