{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rxscan.ca/publication/approval-record-1.0.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "approvalId", "releaseId", "manifestSha256", "approvedAt", "approvers", "consumerTests", "warningDispositions", "comparison"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "approvalId": { "type": "string", "minLength": 1 },
    "releaseId": { "type": "string", "minLength": 1 },
    "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "approvedAt": { "type": "string", "format": "date-time" },
    "approvers": { "type": "object", "required": ["data", "guide", "paramedic"], "properties": { "data": {"type":"string","minLength":1}, "guide": {"type":"string","minLength":1}, "paramedic": {"type":"string","minLength":1} }, "additionalProperties": false },
    "consumerTests": { "type": "object", "required": ["guide", "paramedic"], "properties": { "guide": {"const":"passed"}, "paramedic": {"const":"passed"} }, "additionalProperties": false },
    "warningDispositions": { "type": "array", "items": { "type": "object", "required": ["code", "disposition"], "properties": { "code": {"type":"string"}, "disposition": {"type":"string","minLength":1} }, "additionalProperties": false } },
    "comparison": { "type": "object", "additionalProperties": false, "required": ["status", "baselineReleaseId"], "properties": { "status": { "enum": ["compatible", "initial-candidate"] }, "baselineReleaseId": { "type": ["string", "null"] } } }
  }
}
